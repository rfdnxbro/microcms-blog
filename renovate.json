{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "rangeStrategy": "bump",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"],
    "automerge": true,
    "platformAutomerge": true,
    "labels": ["dependencies"]
  },
  "packageRules": [
    {
      "description": "patch/minor（dependencies / devDependencies）は週次でまとめ、CI 通過後に platform automerge",
      "matchUpdateTypes": ["patch", "minor"],
      "matchDepTypes": ["dependencies", "devDependencies", "optionalDependencies"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "GitHub Actions の patch/minor も同様にまとめ自動マージ",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "github-actions",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "major は自動マージしない。dependencies + needs-review で手動確認",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["needs-review"]
    }
  ]
}
