{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "rangeStrategy": "bump",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"],
    "automerge": true,
    "platformAutomerge": true,
    "labels": ["dependencies"]
  },
  "packageRules": [
    {
      "description": "patch/minor（dependencies / devDependencies / overrides）は週次でまとめ、CI 通過後に platform automerge。本番実行時に影響しうる overrides（undici / zod / nanoid）は除外",
      "matchUpdateTypes": ["patch", "minor"],
      "matchDepTypes": ["dependencies", "devDependencies", "optionalDependencies", "overrides"],
      "matchPackageNames": ["!undici", "!zod", "!nanoid"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "本番実行時に影響しうる overrides（undici / zod / nanoid）は patch/minor でも手動レビュー",
      "matchDepTypes": ["overrides"],
      "matchPackageNames": ["undici", "zod", "nanoid"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": false,
      "platformAutomerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "GitHub Actions の patch/minor も同様にまとめ自動マージ",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "github-actions",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "major は自動マージしない。dependencies + needs-review で手動確認",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["needs-review"]
    }
  ]
}
